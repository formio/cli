node_modules
.dccache
.vscode
.idea
.DS_Store
.vscode/launch.json
npm-debug.log
test/docker/data
# Yarn 4 (Corepack). The cache and install state are local; the lockfile is committed.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Local state, secrets and backups that must never be committed or published. The test env files that
# are already tracked (test.env, test/docker/.env) stay tracked.
settings-backup-*
*.pem
*.key
.env*
*.env

# This project uses Yarn: an npm lockfile would only drift from yarn.lock.
package-lock.json
